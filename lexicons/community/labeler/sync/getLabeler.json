{
  "lexicon": 1,
  "id": "community.labeler.sync.getLabeler",
  "defs": {
    "main": {
      "type": "query",
      "description": "Look up a single labeler registered on this relay by DID. Public endpoint, rate limited per client IP.",
      "parameters": {
        "type": "params",
        "required": ["did"],
        "properties": {
          "did": {
            "type": "string",
            "format": "did",
            "description": "DID of the labeler to look up."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "community.labeler.sync.getLabelers#labelerView"
        }
      }
    }
  }
}
